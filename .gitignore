#IDE Junk
.vscode
.idea/

# Object files
*.o
*.obj

# Temporary files
*.bak
*.tmp

# Compiled files
*.hex
*.bin
*.elf
*.cof

# Debug files
*.d
*.map
/debug

# Build
/build-docs

# Ignore cscope and ctags files
cscope.*
tags

# Executables
*.exe
*.out

#ASF-Specific:
*.atsln
*.atzip
ASF/gcc/*

#MacOS DS_Store
**/.DS_Store

#Windows WSL Identifiers
*.Identifier

#Logs folder
logs/*

#Compilation Database
compile_commands.json
.cache

# Build artifacts
/build

# scratch
scratch/

# Bootloader build artifacts (the ASF Makefile there is tracked) and generated linker scripts
bootloader/ASF/gcc/*
!bootloader/ASF/gcc/Makefile
bootloader/src/stage2_flash[0-9]*.ld
bootloader/src/stage1_flash.ld

# Python bytecode from scripts/
__pycache__/

# User row backups from scripts/ram_ecc_fuse.py
user_row_*.bin
